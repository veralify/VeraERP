import Layout from '@layouts/Default.astro';
---

<Layout
  title='Home'
  pageTitle='Brutal Theme | Home'
  description='Brutal is a minimal neobrutalist theme for Astro with SEO-friendly integrations.'
>
  <main class='bg-pink-theme p-6 space-y-6'>
    <section class='border-2 border-black bg-white p-6 shadow-[6px_6px_0px_0px_#000]'>
      <h1 class='outfit text-4xl md:text-6xl leading-tight'>Brutal for Astro</h1>
      <p class='mt-4 poppins text-lg'>
        Brutal is a minimal neobrutalist theme for Astro, based on Neobrutalist
        Web Design to keep your site functional, fast, and clean.
      </p>
      <p class='mt-2 poppins text-lg'>
        It includes Image Optimization, RSS, and Sitemap support for a strong
        SEO baseline. No JavaScript integration is included by default, but you
        can add it whenever needed.
      </p>
      <p class='mt-4 poppins text-lg'>
        Website: <a class='underline font-bold' href='https://veralify.com'>veralify.com</a>
      </p>
    </section>

    <section class='border-2 border-black bg-white p-6 shadow-[6px_6px_0px_0px_#000]'>
      <h2 class='dm-serif text-3xl md:text-4xl'>Usage</h2>
      <div class='mt-4 space-y-2 poppins text-base'>
        <p><code>npm create astro@latest -- --template eliancodes/brutal</code></p>
        <p><code>pnpm create astro@latest --template eliancodes/brutal</code></p>
        <p><code>yarn create astro --template eliancodes/brutal</code></p>
      </div>
    </section>

    <section class='border-2 border-black bg-white p-6 shadow-[6px_6px_0px_0px_#000]'>
      <h2 class='dm-serif text-3xl md:text-4xl'>Tooling & Commands</h2>
      <p class='mt-4 poppins text-base'>
        The project uses Biome for formatting, linting, and import organization,
        with Astro diagnostics through <code>astro check</code>.
      </p>
      <div class='mt-4 grid gap-2 poppins text-base'>
        <p><code>pnpm install</code> — install dependencies</p>
        <p><code>pnpm dev</code> — start local server at localhost:4321</p>
        <p><code>pnpm check</code> — run Astro checks and Biome checks</p>
        <p><code>pnpm build</code> — build to <code>./dist/</code></p>
        <p><code>pnpm preview</code> — preview production build locally</p>
      </div>
    </section>
  </main>
</Layout>
