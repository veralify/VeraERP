---
import { getActiveBrand } from '@config/brands';
import Layout from '@layouts/Default.astro';

const brand = getActiveBrand();
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

let posts: Array<{
  title: string;
  slug: string;
  excerpt: string | null;
  published_at: string | null;
}> = [];

if (supabaseUrl && supabaseAnonKey) {
  const response = await fetch(`${supabaseUrl}/functions/v1/vera-blog-api`, {
    method: 'POST',
    headers: {
      apikey: supabaseAnonKey,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      action: 'list_published',
      brand: brand.id,
      limit: 20,
    }),
  });

  const json = (await response.json().catch(() => null)) as
    | { data?: typeof posts; error?: string }
    | null;
  if (response.ok && json?.data) {
    posts = json.data;
  }
}
---

<Layout title={`${brand.name} Blog`} pageTitle={`${brand.name} Blog`} description={`News and updates from ${brand.name}.`}>
  <main class='mx-auto w-full max-w-5xl px-6 pb-20 pt-10'>
    <h1 class='matrix-heading text-4xl font-semibold'>Blog</h1>
    <p class='matrix-text mt-3 text-sm' style='color: var(--text-muted);'>
      Insights, updates, and product announcements from Veralify admins.
    </p>

    <div class='mt-8 space-y-4'>
      {
        posts.length ? (
          posts.map((post) => (
            <Fragment key={post.slug}>
              <article class='rounded-2xl border p-5' style='border-color: var(--surface-border);'>
                <p class='matrix-text text-xs' style='color: var(--text-muted);'>
                  {post.published_at ? new Date(post.published_at).toLocaleDateString() : 'Recent'}
                </p>
                <h2 class='matrix-heading mt-2 text-2xl font-semibold'>{post.title}</h2>
                {post.excerpt && (
                  <p class='mt-3 text-sm' style='color: var(--text-muted);'>
                    {post.excerpt}
                  </p>
                )}
                <a href={`/blog/${post.slug}`} class='matrix-text mt-3 inline-flex text-xs underline'>
                  Read article
                </a>
              </article>
            </Fragment>
          ))
        ) : (
          <p class='matrix-text text-sm' style='color: var(--text-muted);'>
            No published posts yet.
          </p>
        )
      }
    </div>
  </main>
</Layout>
