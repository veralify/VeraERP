---
import { getActiveBrand } from '@config/brands';

const brand = getActiveBrand();
---

<main
  class='relative w-full overflow-hidden'
  style='background-color: #05070f; color: var(--text-main);'
>
  <!-- COMMENTED OUT: original decorative brand-color blobs
    <div class='pointer-events-none absolute inset-0'>
      <div class='absolute left-1/2 top-0 h-[24rem] w-[24rem] -translate-x-1/2 rounded-full blur-3xl' style={`background-color: ${brand.theme.primary}40;`} />
      <div class='absolute -left-20 top-40 h-72 w-72 rounded-full blur-3xl' style={`background-color: ${brand.theme.primary}33;`} />
      <div class='absolute -right-20 bottom-0 h-80 w-80 rounded-full blur-3xl' style={`background-color: ${brand.theme.primary}33;`} />
    </div>
  -->

  <!-- Intro / cover screen -->
  <section
    class='relative z-10 flex min-h-screen w-full flex-col items-center justify-center overflow-hidden px-6 text-center'
  >
    <!-- Interactive parallax starfield, confined to this screen -->
    <canvas
      id='starfield'
      class='pointer-events-none absolute inset-0 h-full w-full'
      style='z-index: 0;'
    ></canvas>

    <div class='relative z-10 flex flex-col items-center'>
      <h1 class='text-5xl font-semibold leading-[1.05] tracking-tight md:text-7xl'>
        Good things come
        <br />
        <span class='hero-serif italic'>to those who wait.</span>
      </h1>
    </div>

    <a
      href='#waitlist'
      aria-label='Scroll down'
      class='scroll-cue absolute bottom-10 left-1/2 -translate-x-1/2 text-white/60 transition hover:text-white'
    >
      <svg class='h-7 w-7' viewBox='0 0 24 24' fill='none' aria-hidden='true'>
        <path d='M6 9l6 6 6-6' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' />
      </svg>
    </a>
  </section>

  <!-- Signup / waitlist screen -->
  <section
    id='waitlist'
    class='relative z-10 flex min-h-screen w-full flex-col items-center justify-center px-6 py-16 text-center'
    style='background-color: #05070f;'
  >
    <!-- Planet-horizon backdrop, anchored to the bottom of this screen -->
    <div class='pointer-events-none absolute inset-0 overflow-hidden'>
      <div class='horizon-glow'></div>
      <div class='horizon-arc'></div>
    </div>

    <div class='relative z-10 mx-auto flex w-full max-w-2xl flex-col items-center justify-center text-center'>
    <p
      class='hero-badge inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-sm font-medium'
    >
      {brand.copy.heroBadge}
    </p>

    <h1 class='mt-8 text-5xl font-semibold leading-[1.05] tracking-tight md:text-7xl'>
      {brand.copy.heroTitleLine1}
      <br />
      <span class='hero-serif italic'>{brand.copy.heroTitleLine2}</span>
    </h1>

    <p class='mx-auto mt-6 max-w-md text-base md:text-lg' style='color: var(--text-muted);'>
      {brand.copy.heroDescription}
    </p>

    <form
      id='waitlist-form'
      class='mx-auto mt-10 flex w-full max-w-md items-center gap-2 rounded-xl border p-2'
      style='border-color: rgba(255,255,255,0.12); background-color: rgba(255,255,255,0.04);'
      data-brand={brand.id}
    >
      <input
        type='email'
        id='waitlist-email'
        name='email'
        placeholder='Your Email Address'
        autocomplete='email'
        class='newsletter-input h-11 w-full bg-transparent px-3 text-sm outline-none'
        style='color: var(--text-main);'
        required
      />
      <button
        type='submit'
        class='inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-lg bg-white px-5 text-sm font-semibold text-black transition hover:bg-white/90'
      >
        <svg
          id='waitlist-btn-spinner'
          class='hidden h-4 w-4 animate-spin'
          viewBox='0 0 24 24'
          aria-hidden='true'
        >
          <circle cx='12' cy='12' r='9' stroke='currentColor' stroke-width='3' fill='none' opacity='0.3' />
          <path d='M21 12a9 9 0 0 0-9-9' stroke='currentColor' stroke-width='3' fill='none' />
        </svg>
        <span id='waitlist-btn-label'>Get Notified</span>
      </button>
    </form>
    <label
      for='waitlist-consent'
      class='matrix-text mx-auto mt-3 flex max-w-md cursor-pointer items-start gap-2 text-left text-xs'
      style='color: var(--text-muted);'
    >
      <input
        type='checkbox'
        id='waitlist-consent'
        name='consent'
        class='mt-0.5 h-3.5 w-3.5 shrink-0'
        style={`accent-color: ${brand.theme.primary};`}
      />
      <span>
        I agree to receive product and launch updates from Veralify Ltd and accept the
        <a href='/privacy' class='underline hover:opacity-80'>Privacy Policy</a>.
      </span>
    </label>
    <p id='waitlist-status' class='mt-3 text-xs' style='color: var(--text-muted);'></p>
    </div>

    <!-- COMMENTED OUT: social proof avatars + joined count
    <div id='waitlist-social-proof' class='mt-8 hidden items-center justify-center gap-3'>
      <div class='flex -space-x-2'>
        <span class='inline-block h-7 w-7 rounded-full border-2' style='border-color: var(--page-bg); background: linear-gradient(135deg, #3B82F6, #93c5fd);'></span>
        <span class='inline-block h-7 w-7 rounded-full border-2' style='border-color: var(--page-bg); background: linear-gradient(135deg, #3b82f6, #22d3ee);'></span>
        <span class='inline-block h-7 w-7 rounded-full border-2' style='border-color: var(--page-bg); background: linear-gradient(135deg, #a855f7, #ec4899);'></span>
      </div>
      <p class='matrix-text text-sm' style='color: var(--text-muted);'>
        <span id='waitlist-count' class='font-semibold' style='color: var(--text-main);'>0</span>
        <span> have already joined</span>
      </p>
    </div>
    -->
  </section>

</main>

<style>
  .hero-badge {
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgba(255, 255, 255, 0.06);
    color: #e5e7eb;
    backdrop-filter: blur(6px);
  }

  .hero-serif {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
  }

  /* Soft blue atmospheric glow rising from the horizon */
  .horizon-glow {
    position: absolute;
    left: 50%;
    bottom: -25vh;
    width: 120vw;
    height: 80vh;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at center,
      rgba(59, 130, 246, 0.4) 0%,
      rgba(37, 99, 235, 0.16) 38%,
      rgba(5, 7, 15, 0) 70%
    );
    filter: blur(24px);
  }

  /* The bright curved planet edge. A circle sized to the viewport width, with
     its top (the arc peak) locked to a fixed vh position via calc(), so the
     curve looks identical — like the reference photo — on every screen size
     and aspect ratio, not just narrow/mobile. */
  .horizon-arc {
    position: absolute;
    left: 50%;
    width: 185vw;
    height: 185vw;
    bottom: calc(45vh - 185vw);
    transform: translateX(-50%);
    border-radius: 50%;
    background: #05070f;
    border-top: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow:
      0 -2px 70px 4px rgba(191, 219, 254, 0.28),
      inset 0 3px 40px rgba(147, 197, 253, 0.14);
  }

  .newsletter-input:focus,
  .newsletter-input:focus-visible {
    outline: none;
    box-shadow: none;
    background-color: transparent;
  }

  .newsletter-input:-webkit-autofill,
  .newsletter-input:-webkit-autofill:hover,
  .newsletter-input:-webkit-autofill:focus,
  .newsletter-input:-webkit-autofill:active {
    -webkit-text-fill-color: var(--text-main);
    transition: background-color 9999s ease-in-out 0s;
    box-shadow: 0 0 0 1000px transparent inset;
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-6px); }
    20%, 40%, 60%, 80% { transform: translateX(6px); }
  }

  .shake {
    animation: shake 0.4s ease-in-out;
  }
</style>

<script>
  // Interactive parallax starfield — stars drift and shift with mouse + scroll.
  function initStarfield() {
    const canvas = document.getElementById('starfield');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Tear down any previous loop (Astro view transitions re-run this).
    const w = window as unknown as { __starRAF?: number };
    if (w.__starRAF) cancelAnimationFrame(w.__starRAF);

    let width = 0;
    let height = 0;
    let dpr = 1;
    let stars: {
      x: number;
      y: number;
      r: number;
      depth: number;
      base: number;
      tw: number;
      tws: number;
    }[] = [];

    let mx = 0;
    let my = 0;
    let tx = 0;
    let ty = 0;
    let scrollY = 0;

    const makeStars = () => {
      const count = Math.min(220, Math.round((width * height) / (dpr * dpr) / 6500));
      stars = [];
      for (let i = 0; i < count; i++) {
        const depth = Math.random();
        stars.push({
          x: Math.random() * width,
          y: Math.random() * height,
          r: (depth * 1.5 + 0.35) * dpr,
          depth: depth * 0.9 + 0.1,
          base: 0.35 + depth * 0.6,
          tw: Math.random() * Math.PI * 2,
          tws: 0.4 + Math.random() * 1.6,
        });
      }
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.width = Math.floor(window.innerWidth * dpr);
      height = canvas.height = Math.floor(window.innerHeight * dpr);
      canvas.style.width = window.innerWidth + 'px';
      canvas.style.height = window.innerHeight + 'px';
      makeStars();
    };

    const onMove = (e: MouseEvent) => {
      tx = e.clientX / window.innerWidth - 0.5;
      ty = e.clientY / window.innerHeight - 0.5;
    };
    const onTouch = (e: TouchEvent) => {
      const t = e.touches[0];
      if (!t) return;
      tx = t.clientX / window.innerWidth - 0.5;
      ty = t.clientY / window.innerHeight - 0.5;
    };
    const onScroll = () => {
      scrollY = window.scrollY || window.pageYOffset || 0;
    };

    let t = 0;
    const wrap = (v: number, max: number) => ((v % max) + max) % max;

    const draw = () => {
      t += 0.016;
      mx += (tx - mx) * 0.05;
      my += (ty - my) * 0.05;
      ctx.clearRect(0, 0, width, height);

      const shiftX = mx * 90 * dpr;
      const shiftY = my * 90 * dpr;

      for (const s of stars) {
        const px = wrap(s.x - shiftX * s.depth, width);
        const py = wrap(
          s.y - shiftY * s.depth - scrollY * dpr * s.depth * 0.35,
          height,
        );
        const twinkle = 0.65 + 0.35 * Math.sin(t * s.tws + s.tw);
        ctx.globalAlpha = Math.min(1, s.base * twinkle);
        ctx.beginPath();
        ctx.arc(px, py, s.r, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      w.__starRAF = requestAnimationFrame(draw);
    };

    resize();
    onScroll();
    window.addEventListener('resize', resize);
    window.addEventListener('mousemove', onMove);
    window.addEventListener('touchmove', onTouch, { passive: true });
    window.addEventListener('scroll', onScroll, { passive: true });
    w.__starRAF = requestAnimationFrame(draw);
  }

  document.addEventListener('astro:page-load', initStarfield);
  if (document.readyState !== 'loading') initStarfield();
</script>

<script>
  document.addEventListener('astro:page-load', () => {
    const countEl = document.getElementById('waitlist-count');
    const socialProof = document.getElementById('waitlist-social-proof');
    if (countEl && socialProof) {
      fetch('/api/waitlist-count')
        .then((r) => r.json())
        .then((d) => {
          const count = typeof d.count === 'number' ? d.count : 0;
          if (count > 0) {
            countEl.textContent = count.toLocaleString('en-US');
            socialProof.classList.remove('hidden');
            socialProof.classList.add('flex');
          }
        })
        .catch(() => {});
    }

    const form = document.getElementById('waitlist-form');
    const emailInput = document.getElementById('waitlist-email');
    const consentInput = document.getElementById('waitlist-consent');
    const statusText = document.getElementById('waitlist-status');

    if (!(form instanceof HTMLFormElement) || !(emailInput instanceof HTMLInputElement)) {
      return;
    }

    const brand = form.dataset.brand || 'veralify';
    const submitButton = form.querySelector('button[type="submit"]');
    const buttonLabel = document.getElementById('waitlist-btn-label');
    const buttonSpinner = document.getElementById('waitlist-btn-spinner');

    const setLoading = (loading: boolean) => {
      if (buttonSpinner instanceof SVGElement) {
        buttonSpinner.classList.toggle('hidden', !loading);
      }
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = loading;
      }
      if (buttonLabel instanceof HTMLElement) {
        buttonLabel.textContent = loading ? 'Joining' : 'Get Notified';
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = emailInput.value.trim();
      if (!email) {
        emailInput.classList.add('shake');
        setTimeout(() => emailInput.classList.remove('shake'), 400);
        return;
      }

      const consent = consentInput instanceof HTMLInputElement ? consentInput.checked : false;
      if (!consent) {
        if (statusText) {
          statusText.textContent = 'Please tick the consent box to join the waitlist.';
        }
        return;
      }

      setLoading(true);
      if (statusText) {
        statusText.textContent = '';
      }

      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            email,
            brand,
            consent,
            source: 'waitlist',
            ref: new URLSearchParams(window.location.search).get('ref'),
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Something went wrong.');

        form.reset();
        const params = new URLSearchParams();
        if (data.position) params.set('pos', String(data.position));
        if (data.referralCode) params.set('ref', data.referralCode);
        if (data.alreadySubscribed) params.set('welcome', 'back');
        window.location.href = `/welcome?${params.toString()}`;
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Something went wrong.';
        if (statusText) {
          statusText.textContent = message;
        }
      } finally {
        setLoading(false);
      }
    });
  });
</script>

