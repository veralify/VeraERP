---
import { AuthWidget } from '@components/auth/AuthWidget';
import { getActiveBrand } from '@config/brands';

const hasPrivyAppId = Boolean(import.meta.env.PUBLIC_PRIVY_APP_ID);
const brand = getActiveBrand();
---

<main
  class='relative overflow-hidden px-6 pb-20 pt-14 md:pt-20'
  style='background-color: var(--page-bg); color: var(--text-main);'
>
  <div class='pointer-events-none absolute inset-0'>
    <div
      class='absolute left-1/2 top-0 h-[24rem] w-[24rem] -translate-x-1/2 rounded-full blur-3xl'
      style={`background-color: ${brand.theme.primary}40;`}
    />
    <div
      class='absolute -left-20 top-40 h-72 w-72 rounded-full blur-3xl'
      style={`background-color: ${brand.theme.primary}33;`}
    />
    <div
      class='absolute -right-20 bottom-0 h-80 w-80 rounded-full blur-3xl'
      style={`background-color: ${brand.theme.primary}33;`}
    />
  </div>

  <section
    class='relative mx-auto grid w-full max-w-6xl gap-10 rounded-3xl border p-8 shadow-[0_0_120px_rgba(232,65,37,0.22)] backdrop-blur-xl md:grid-cols-2 md:p-12'
    style='border-color: var(--surface-border); background-color: var(--surface);'
  >
    <div>
      <p
        class='matrix-text inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium tracking-wide'
        style='border-color: var(--chip-border); background-color: var(--chip-bg); color: var(--chip-text);'
      >
        {brand.copy.heroBadge}
      </p>
      <h1 class='matrix-heading mt-5 text-4xl font-semibold leading-tight tracking-tight md:text-6xl'>
        {brand.copy.heroTitleLine1}
        <br />
        {brand.copy.heroTitleLine2}
      </h1>
      <p class='matrix-text mt-5 max-w-xl text-base md:text-lg' style='color: var(--text-muted);'>
        {brand.copy.heroDescription}
      </p>

      <div class='mt-8 flex flex-wrap gap-3'>
        <a
          href={brand.social.xUrl}
          target='_blank'
          rel='noopener noreferrer'
          class='matrix-text inline-flex h-[46px] items-center rounded-xl px-6 font-semibold text-black transition hover:brightness-110'
          style={`background-color: ${brand.theme.primary};`}
        >
          Follow on X
        </a>
        {
          hasPrivyAppId ? (
            <AuthWidget variant="hero" client:only="react" />
          ) : (
            <button
              type='button'
              class='matrix-text inline-flex h-[46px] items-center rounded-xl border px-6 font-semibold'
              style={`border-color: ${brand.theme.authAccent}; color: #f3ddad; background-color: #141414;`}
              title='Set PUBLIC_PRIVY_APP_ID to enable social login.'
            >
              Sign In
            </button>
          )
        }
      </div>
    </div>

    <div
      class='rounded-2xl border p-6'
      style='border-color: var(--surface-border); background-color: var(--surface-elevated);'
    >
      <div class='flex items-center gap-3'>
        <img src={brand.assets.logoPath} alt={`${brand.name} logo`} width='48' height='48' loading='eager' />
        <div>
          <p class='matrix-text text-sm' style='color: var(--text-muted);'>{brand.copy.networkLabel}</p>
          <p class='matrix-heading text-lg font-semibold'>{brand.copy.networkTitle}</p>
        </div>
      </div>

      <div class='matrix-text mt-6 space-y-3 text-sm' style='color: var(--text-muted);'>
        {
          brand.copy.highlights.map((highlight) => (
            <div
              key={highlight}
              class='rounded-lg border p-3'
              style='border-color: var(--item-border); background-color: var(--item-bg);'
            >
              {highlight}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</main>
