---
import { getActiveBrand } from '@config/brands';

const brand = getActiveBrand();
---

<main
  class='relative overflow-hidden px-6 pb-20 pt-14 md:pt-20'
  style='background-color: var(--page-bg); color: var(--text-main);'
>
  <div class='pointer-events-none absolute inset-0'>
    <div
      class='absolute left-1/2 top-0 h-[24rem] w-[24rem] -translate-x-1/2 rounded-full blur-3xl'
      style={`background-color: ${brand.theme.primary}40;`}
    />
    <div
      class='absolute -left-20 top-40 h-72 w-72 rounded-full blur-3xl'
      style={`background-color: ${brand.theme.primary}33;`}
    />
    <div
      class='absolute -right-20 bottom-0 h-80 w-80 rounded-full blur-3xl'
      style={`background-color: ${brand.theme.primary}33;`}
    />
  </div>

  <section class='relative mx-auto flex min-h-[70vh] w-full max-w-2xl flex-col items-center justify-center text-center'>
    <p
      class='matrix-text inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium uppercase tracking-wide'
      style='border-color: var(--chip-border); background-color: var(--chip-bg); color: var(--chip-text);'
    >
      {brand.copy.heroBadge}
    </p>

    <h1 class='matrix-heading mt-6 text-4xl font-semibold leading-[1.1] tracking-tight md:text-6xl'>
      <span data-scramble>{brand.copy.heroTitleLine1}</span>
      <br />
      <span data-scramble data-scramble-delay='150'>{brand.copy.heroTitleLine2}</span>
    </h1>

    <p class='matrix-text mx-auto mt-6 max-w-xl text-base md:text-lg' style='color: var(--text-muted);'>
      {brand.copy.heroDescription}
    </p>

    <form
      id='waitlist-form'
      class='mx-auto mt-9 flex w-full max-w-md items-center gap-2 rounded-full border p-1.5'
      style='border-color: var(--surface-border); background-color: var(--page-bg);'
      data-brand={brand.id}
    >
      <input
        type='email'
        id='waitlist-email'
        name='email'
        placeholder='name@domain.com'
        autocomplete='email'
        class='newsletter-input h-10 w-full bg-transparent px-3 text-sm outline-none'
        style='color: var(--text-main);'
        required
      />
      <button
        type='submit'
        class='matrix-text inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-full px-5 text-xs font-semibold text-white transition hover:brightness-110'
        style={`background-color: ${brand.theme.primary};`}
      >
        <svg
          id='waitlist-btn-spinner'
          class='hidden h-4 w-4 animate-spin'
          viewBox='0 0 24 24'
          aria-hidden='true'
        >
          <circle cx='12' cy='12' r='9' stroke='currentColor' stroke-width='3' fill='none' opacity='0.3' />
          <path d='M21 12a9 9 0 0 0-9-9' stroke='currentColor' stroke-width='3' fill='none' />
        </svg>
        <span id='waitlist-btn-label'>Join now</span>
      </button>
    </form>
    <label
      for='waitlist-consent'
      class='matrix-text mx-auto mt-3 flex max-w-md cursor-pointer items-start gap-2 text-left text-xs'
      style='color: var(--text-muted);'
    >
      <input
        type='checkbox'
        id='waitlist-consent'
        name='consent'
        class='mt-0.5 h-3.5 w-3.5 shrink-0'
        style={`accent-color: ${brand.theme.primary};`}
      />
      <span>
        I agree to receive product and launch updates from Veralify Ltd and accept the
        <a href='/privacy' class='underline hover:opacity-80'>Privacy Policy</a>.
      </span>
    </label>
    <p id='waitlist-status' class='mt-3 text-xs' style='color: var(--text-muted);'></p>

    <div id='waitlist-social-proof' class='mt-8 hidden items-center justify-center gap-3'>
      <div class='flex -space-x-2'>
        <span class='inline-block h-7 w-7 rounded-full border-2' style='border-color: var(--page-bg); background: linear-gradient(135deg, #E84125, #ff8a5b);'></span>
        <span class='inline-block h-7 w-7 rounded-full border-2' style='border-color: var(--page-bg); background: linear-gradient(135deg, #3b82f6, #22d3ee);'></span>
        <span class='inline-block h-7 w-7 rounded-full border-2' style='border-color: var(--page-bg); background: linear-gradient(135deg, #a855f7, #ec4899);'></span>
      </div>
      <p class='matrix-text text-sm' style='color: var(--text-muted);'>
        <span id='waitlist-count' class='font-semibold' style='color: var(--text-main);'>0</span>
        <span> have already joined</span>
      </p>
    </div>
  </section>

</main>

<style>
  .newsletter-input:focus,
  .newsletter-input:focus-visible {
    outline: none;
    box-shadow: none;
    background-color: transparent;
  }

  .newsletter-input:-webkit-autofill,
  .newsletter-input:-webkit-autofill:hover,
  .newsletter-input:-webkit-autofill:focus,
  .newsletter-input:-webkit-autofill:active {
    -webkit-text-fill-color: var(--text-main);
    transition: background-color 9999s ease-in-out 0s;
    box-shadow: 0 0 0 1000px transparent inset;
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-6px); }
    20%, 40%, 60%, 80% { transform: translateX(6px); }
  }

  .shake {
    animation: shake 0.4s ease-in-out;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const countEl = document.getElementById('waitlist-count');
    const socialProof = document.getElementById('waitlist-social-proof');
    if (countEl && socialProof) {
      fetch('/api/waitlist-count')
        .then((r) => r.json())
        .then((d) => {
          const count = typeof d.count === 'number' ? d.count : 0;
          if (count > 0) {
            countEl.textContent = count.toLocaleString('en-US');
            socialProof.classList.remove('hidden');
            socialProof.classList.add('flex');
          }
        })
        .catch(() => {});
    }

    const form = document.getElementById('waitlist-form');
    const emailInput = document.getElementById('waitlist-email');
    const consentInput = document.getElementById('waitlist-consent');
    const statusText = document.getElementById('waitlist-status');

    if (!(form instanceof HTMLFormElement) || !(emailInput instanceof HTMLInputElement)) {
      return;
    }

    const brand = form.dataset.brand || 'veralify';
    const submitButton = form.querySelector('button[type="submit"]');
    const buttonLabel = document.getElementById('waitlist-btn-label');
    const buttonSpinner = document.getElementById('waitlist-btn-spinner');

    const setLoading = (loading: boolean) => {
      if (buttonSpinner instanceof SVGElement) {
        buttonSpinner.classList.toggle('hidden', !loading);
      }
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = loading;
      }
      if (buttonLabel instanceof HTMLElement) {
        buttonLabel.textContent = loading ? 'Joining' : 'Get Early Access';
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = emailInput.value.trim();
      if (!email) {
        emailInput.classList.add('shake');
        setTimeout(() => emailInput.classList.remove('shake'), 400);
        return;
      }

      const consent = consentInput instanceof HTMLInputElement ? consentInput.checked : false;
      if (!consent) {
        if (statusText) {
          statusText.textContent = 'Please tick the consent box to join the waitlist.';
        }
        return;
      }

      setLoading(true);
      if (statusText) {
        statusText.textContent = '';
      }

      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            email,
            brand,
            consent,
            source: 'waitlist',
            ref: new URLSearchParams(window.location.search).get('ref'),
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Something went wrong.');

        form.reset();
        const params = new URLSearchParams();
        if (data.position) params.set('pos', String(data.position));
        if (data.referralCode) params.set('ref', data.referralCode);
        if (data.alreadySubscribed) params.set('welcome', 'back');
        window.location.href = `/welcome?${params.toString()}`;
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Something went wrong.';
        if (statusText) {
          statusText.textContent = message;
        }
      } finally {
        setLoading(false);
      }
    });
  });
</script>

<script>
  const SCRAMBLE_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#$%&!><';
  const REVEAL_MS = 90;
  const TICK_MS = 40;

  function runScramble(el: HTMLElement) {
    const target = el.textContent ?? '';
    if (!target.trim()) return;

    let nonSpaceIdx = 0;
    const lockAt = [...target].map((c) => (c === ' ' ? -1 : nonSpaceIdx++ * REVEAL_MS));
    const duration = nonSpaceIdx * REVEAL_MS;
    const t0 = performance.now();

    const id = setInterval(() => {
      const elapsed = performance.now() - t0;
      let html = '';

      for (let i = 0; i < target.length; i++) {
        const ch = target[i];
        if (ch === ' ') { html += ' '; continue; }
        if (elapsed >= lockAt[i]) {
          html += ch;
        } else {
          const progress = elapsed / lockAt[i];
          const opacity = (0.55 + 0.45 * progress).toFixed(2);
          const rand = SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
          html += `<span style="color:#e84125;opacity:${opacity}">${rand}</span>`;
        }
      }

      el.innerHTML = html;

      if (elapsed >= duration) {
        el.textContent = target;
        clearInterval(id);
      }
    }, TICK_MS);
  }

  function initScramble() {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            runScramble(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 }
    );
    document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el) => observer.observe(el));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScramble);
  } else {
    initScramble();
  }
</script>
