---
export interface Props {
  backToTop?: boolean;
}

const { backToTop = false } = Astro.props;
---

{
  backToTop && (
    <button
      type='button'
      class:list={[
        backToTop ? `backToTop` : null,
        'fixed bottom-[10px] right-[30px] z-50 flex h-10 w-10 border border-black bg-white opacity-0 transition-all duration-300 card-shadow',
      ]}
      aria-label='Back to top'
    >
      <svg
        xmlns='http://www.w3.org/2000/svg'
        fill='none'
        viewBox='0 0 24 24'
        height='100%'
        width='100%'
        stroke-width='1.5'
        stroke='currentColor'
      >
        <title>Back to top</title>
        <path
          stroke-linecap='round'
          stroke-linejoin='round'
          d='m4.5 15.75 7.5-7.5 7.5 7.5'
        />
      </svg>
    </button>
  )
}

<footer
  class='border-t px-6 py-8'
  style='border-color: var(--surface-border); background-color: var(--page-bg); color: var(--text-muted);'
>
  <h2 class='hidden'>Footer</h2>
  <div class='matrix-text mx-auto grid w-full max-w-6xl items-center gap-4 text-sm md:grid-cols-3'>
    <div class='space-y-1 md:justify-self-start'>
      <p style='color: var(--text-main);'>VERALIFY LTD. Company Number: 17332341.</p>
      <p class='text-xs'>Registered in England and Wales.</p>
      <p class='text-xs'>© 2026 Veralify. All rights reserved.</p>
    </div>

    <div class='justify-self-center'>
      <nav class='flex items-center gap-4 text-xs'>
        <a
          href='/feedback'
          class='transition hover:text-[#E84125]'
          style='color: var(--text-muted);'
        >
          Feedback
        </a>
        <span aria-hidden='true' style='color: var(--surface-border);'>·</span>
        <a
          href='/privacy'
          class='transition hover:text-[#E84125]'
          style='color: var(--text-muted);'
        >
          Privacy Policy
        </a>
        <span aria-hidden='true' style='color: var(--surface-border);'>·</span>
        <a
          href='/terms'
          class='transition hover:text-[#E84125]'
          style='color: var(--text-muted);'
        >
          Terms of Service
        </a>
      </nav>
    </div>

    <div class='flex items-center justify-start gap-4 md:justify-self-end'>
      <a
        href='https://github.com/veralify'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='Veralify on GitHub'
        class='transition hover:text-[#E84125]'
        style='color: var(--text-muted);'
      >
        <svg viewBox='0 0 24 24' aria-hidden='true' class='h-5 w-5 fill-current'>
          <path d='M12 2C6.48 2 2 6.59 2 12.24c0 4.52 2.87 8.35 6.84 9.7.5.1.66-.22.66-.49 0-.24-.01-1.05-.01-1.91-2.78.62-3.37-1.22-3.37-1.22-.46-1.2-1.11-1.52-1.11-1.52-.91-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.9 1.58 2.36 1.13 2.93.86.09-.67.35-1.13.64-1.39-2.22-.26-4.56-1.14-4.56-5.09 0-1.13.39-2.05 1.04-2.78-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.06A9.28 9.28 0 0 1 12 6.89a9.2 9.2 0 0 1 2.5.35c1.9-1.34 2.74-1.06 2.74-1.06.55 1.42.2 2.47.1 2.73.65.73 1.04 1.65 1.04 2.78 0 3.96-2.34 4.82-4.57 5.08.36.32.68.94.68 1.9 0 1.38-.01 2.49-.01 2.83 0 .27.16.59.67.49A10.12 10.12 0 0 0 22 12.24C22 6.59 17.52 2 12 2Z' />
        </svg>
      </a>
      <a
        href='https://x.com/Veralify'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='Veralify on X'
        class='transition hover:text-[#E84125]'
        style='color: var(--text-muted);'
      >
        <svg viewBox='0 0 24 24' aria-hidden='true' class='h-5 w-5 fill-current'>
          <path d='M18.9 2H22l-6.8 7.7L23 22h-6.4l-5-6.5L5.8 22H2.7l7.3-8.3L1 2h6.6l4.5 5.9L18.9 2Zm-1.1 18h1.7L6.6 3.9H4.8L17.8 20Z' />
        </svg>
      </a>
      <a
        href='https://www.linkedin.com'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='Veralify on LinkedIn'
        class='transition hover:text-[#E84125]'
        style='color: var(--text-muted);'
      >
        <svg viewBox='0 0 24 24' aria-hidden='true' class='h-5 w-5 fill-current'>
          <path d='M4.98 3.5a2.5 2.5 0 1 0 .02 5 2.5 2.5 0 0 0-.02-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.8 2.6 4.8 6V21h-4v-5.3c0-1.3 0-2.8-1.8-2.8-1.8 0-2 1.4-2 2.7V21h-4V9Z' />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .backToTop.active {
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const backToTop = document.querySelector('.backToTop');

    const toggleBackToTopButton = () => {
      if (window.scrollY > 250) {
        backToTop?.classList.add('active');
      } else {
        backToTop?.classList.remove('active');
      }
    };

    backToTop?.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });

    window.addEventListener('scroll', toggleBackToTopButton);
  });
</script>
