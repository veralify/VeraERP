---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';

interface Props {
  pageTitle?: string;
}

const { pageTitle } = Astro.props;
---

<header
  class='sticky top-0 z-40 border-b px-6 py-4'
  style='border-color: var(--surface-border); background-color: var(--page-bg);'
>
  {pageTitle && <h1 class='hidden'>{pageTitle}</h1>}
  <div class='mx-auto flex w-full max-w-6xl items-center'>
    <div class='matrix-text inline-flex items-center gap-3'>
      <Image
        src={logo}
        alt='Veralify logo'
        width={40}
        height={40}
        loading='eager'
        fetchpriority='high'
        class='rounded-xl object-cover ring-1'
        style='--tw-ring-color: var(--logo-ring);'
      />
      <p class='matrix-heading text-xl font-semibold tracking-tight md:text-2xl'>Veralify</p>
      <span class='h-2 w-2 rounded-full bg-[#E84125] shadow-[0_0_12px_rgba(232,65,37,0.9)]' />
    </div>

  </div>
</header>
