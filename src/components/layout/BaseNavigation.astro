---
import { AuthWidget } from '@components/auth/AuthWidget';
import { NavSearch } from '@components/search/NavSearch';
import { getActiveBrand } from '@config/brands';

interface Props {
  pageTitle?: string;
}

const { pageTitle } = Astro.props;
const hasPrivyAppId = Boolean(import.meta.env.PUBLIC_PRIVY_APP_ID);
const brand = getActiveBrand();
---

<header
  class='sticky top-0 z-40 border-b px-6 py-4'
  style='border-color: var(--surface-border); background-color: var(--page-bg);'
>
  {pageTitle && <h1 class='hidden'>{pageTitle}</h1>}
  <div class='mx-auto flex w-full max-w-6xl items-center justify-between'>
    <a href='/' data-astro-reload class='matrix-text inline-flex items-center gap-3 hover:opacity-80 transition-opacity'>
      <img src={brand.assets.logoPath} alt={`${brand.name} logo`} width='40' height='40' loading='eager' />
      <p class='matrix-heading text-xl font-semibold tracking-tight md:text-2xl'>{brand.shortName}</p>
      <span
        class='h-2 w-2 rounded-full'
        style={`background-color: ${brand.theme.primary}; box-shadow: 0 0 12px ${brand.theme.primary};`}
      />
    </a>
    <div class='flex items-center gap-3'>
      <NavSearch client:only="react" />
      {hasPrivyAppId ? <AuthWidget client:only="react" /> : null}
    </div>
  </div>
</header>
