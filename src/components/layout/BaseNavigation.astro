---
import { AuthWidget } from '@components/auth/AuthWidget';
import { getActiveBrand } from '@config/brands';

interface Props {
  pageTitle?: string;
}

const { pageTitle } = Astro.props;
const hasPrivyAppId = Boolean(import.meta.env.PUBLIC_PRIVY_APP_ID);
const brand = getActiveBrand();
---

<header
  id='site-nav'
  class='sticky top-0 z-40 border-b px-6 py-4 transition-transform duration-300 will-change-transform'
  style='border-color: rgb(255 255 255 / 8%); background-color: var(--page-bg);'
>
  {pageTitle && <h1 class='hidden'>{pageTitle}</h1>}
  <div class='relative mx-auto flex w-full max-w-6xl items-center justify-center'>
    <a href='/' data-astro-reload class='matrix-text inline-flex items-center gap-3 hover:opacity-80 transition-opacity'>
      <img src={brand.assets.logoPath} alt={`${brand.name} logo`} width='40' height='40' loading='eager' />
      <p class='matrix-heading text-xl font-semibold tracking-tight md:text-2xl'>{brand.shortName}</p>
    </a>
    {hasPrivyAppId ? <div class='absolute right-6'><AuthWidget client:only='react' /></div> : null}
  </div>
</header>

<style>
  #site-nav.nav-hidden {
    transform: translateY(-100%);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const nav = document.getElementById('site-nav');
    if (!nav) return;

    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      // Reveal near the top; otherwise hide on scroll-down, show on scroll-up.
      if (y <= 80 || y < lastY) {
        nav.classList.remove('nav-hidden');
      } else if (y > lastY) {
        nav.classList.add('nav-hidden');
      }
      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  });
</script>
