<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="vera_theme_web_layout_branding" inherit_id="web.layout" name="veraERP Web Layout Branding">
        <xpath expr="//head/title" position="replace">
            <title t-esc="title or 'veraERP'"/>
        </xpath>
        <xpath expr="//head/link[@rel='shortcut icon']" position="replace">
            <link type="image/svg+xml" rel="shortcut icon" href="/vera_theme/static/src/img/veraerp-logo.svg"/>
        </xpath>
    </template>

    <template id="vera_theme_login_layout_branding" inherit_id="web.login_layout" name="veraERP Login Branding">
        <xpath expr="//div[hasclass('text-center') and hasclass('pb-3')]/img" position="replace">
            <img src="/vera_theme/static/src/img/veraerp-logo.svg" alt="veraERP" style="max-height:72px; max-width: 100%; width:auto"/>
        </xpath>
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <a href="https://veralify.com" target="_blank">Powered by <span>veraERP</span></a>
        </xpath>
    </template>

    <template id="vera_theme_brand_promotion_override" inherit_id="web.brand_promotion" name="veraERP Promotion Override">
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace">
            <div class="o_brand_promotion">Powered by veraERP</div>
        </xpath>
    </template>
</odoo>
