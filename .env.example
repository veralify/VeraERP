# ── Public browser-safe configuration ─────────────────────────────
NEXT_PUBLIC_BRAND=veralify
NEXT_PUBLIC_TWENTY_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# PostHog project key for browser analytics.
NEXT_PUBLIC_POSTHOG_KEY=
# Browser-safe Sentry DSN for client-side error reporting.
NEXT_PUBLIC_SENTRY_DSN=

# ── Server-only secrets (NEVER prefix with NEXT_PUBLIC_, never commit) ───
# Supabase Dashboard → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter API key for the AI gateway.
OPENROUTER_API_KEY=

# Agora credentials for server-side RTC token generation.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Stripe Billing and webhook verification.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
# Recurring Price ID for the existing web subscription plan.
STRIPE_PRICE_VERALIFY_PLUS=price_xxxxxxxxx

# Apple In-App Purchase / App Store Server API credentials.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_BUNDLE_ID=

# APNs key credentials for durable notification delivery.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# Sentry DSN for server-side and Edge Function error reporting.
SENTRY_DSN=

# Nutrition provenance provider API key.
FOOD_DATA_PROVIDER_KEY=

# Resend → https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
# Use a verified domain in production (e.g. noreply@veralify.com).
# onboarding@resend.dev only delivers to your own Resend account email.
RESEND_FROM=onboarding@resend.dev

# ── Passkeys (WebAuthn) — set on the Supabase `passkey` Edge Function ───
# Relying Party ID must match your domain (no scheme/port). Use "localhost" in dev.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Veralify
# Full origin the browser runs on. Dev: http://localhost:3000 · Prod: https://veralify.com
WEBAUTHN_ORIGIN=http://localhost:3000
