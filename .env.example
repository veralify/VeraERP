# ── Public (shipped to browser — safe) ─────────────────────────────
NEXT_PUBLIC_BRAND=veralify
NEXT_PUBLIC_TWENTY_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── Server-only secrets (NEVER prefix with NEXT_PUBLIC_, never commit) ───
# Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# ── Passkeys (WebAuthn) — set on the Supabase `passkey` Edge Function ───
# Relying Party ID must match your domain (no scheme/port). Use "localhost" in dev.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Veralify
# Full origin the browser runs on. Dev: http://localhost:3000 · Prod: https://veralify.com
WEBAUTHN_ORIGIN=http://localhost:3000


# Veralify API Gateway integrations
OPENAI_API_KEY=
DUFFEL_API_KEY=
ESIM_GO_API_KEY=

# Resend → https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
# Use a verified domain in production (e.g. noreply@veralify.com).
# onboarding@resend.dev only delivers to your own Resend account email.
RESEND_FROM=onboarding@resend.dev

# Stripe → https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
# Stripe Dashboard → Developers → Webhooks → signing secret for this endpoint.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
# Recurring Price ID for the "Veralify Plus" subscription plan.
STRIPE_PRICE_VERALIFY_PLUS=price_xxxxxxxxx
