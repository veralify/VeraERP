		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Calcolata sulla %lld rata che ti resta. Se la lettera del tuo istituto dice altro, usa il loro importo.</string>
			<key>other</key>
			<string>Calcolata sulle %lld rate che ti restano. Se la lettera del tuo istituto dice altro, usa il loro importo.</string>
