<dict>
	<key>%@ is due in %lld days.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ is due in %2$lld day.</string>
			<key>other</key>
			<string>%1$@ is due in %2$lld days.</string>
		</dict>
	</dict>
