	<key>%lld items have no due date, so nothing can be scheduled for them.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld عناصر بلا تاريخ استحقاق، فلا يمكن جدولة شيء لها.</string>
			<key>many</key>
			<string>%lld عنصرًا بلا تاريخ استحقاق، فلا يمكن جدولة شيء لها.</string>
			<key>one</key>
			<string>عنصر واحد بلا تاريخ استحقاق، فلا يمكن جدولة شيء له.</string>
			<key>other</key>
			<string>%lld عنصر بلا تاريخ استحقاق، فلا يمكن جدولة شيء لها.</string>
			<key>two</key>
			<string>عنصران بلا تاريخ استحقاق، فلا يمكن جدولة شيء لهما.</string>
			<key>zero</key>
			<string>لا عناصر بلا تاريخ استحقاق.</string>
		</dict>
	</dict>
	<key>%lld items have no due date, so they can't be flagged.</key>
