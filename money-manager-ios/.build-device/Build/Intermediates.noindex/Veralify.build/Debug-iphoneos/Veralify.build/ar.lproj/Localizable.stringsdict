<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ is due in %lld days.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%1$@ مستحقة خلال %2$lld أيام.</string>
			<key>many</key>
			<string>%1$@ مستحقة خلال %2$lld يومًا.</string>
			<key>one</key>
			<string>%1$@ مستحقة خلال يوم.</string>
			<key>other</key>
			<string>%1$@ مستحقة خلال %2$lld يوم.</string>
			<key>two</key>
			<string>%1$@ مستحقة خلال يومين.</string>
			<key>zero</key>
			<string>%1$@ مستحقة اليوم.</string>
		</dict>
	</dict>
	<key>%lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
