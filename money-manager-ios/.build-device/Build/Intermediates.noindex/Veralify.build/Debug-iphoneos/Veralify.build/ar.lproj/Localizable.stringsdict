	<key>Alerts, %lld needing attention</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>التنبيهات، %lld بنود تحتاج انتباهك</string>
			<key>many</key>
			<string>التنبيهات، %lld بندًا يحتاج انتباهك</string>
			<key>one</key>
			<string>التنبيهات، بند واحد يحتاج انتباهك</string>
			<key>other</key>
			<string>التنبيهات، %lld بند يحتاج انتباهك</string>
			<key>two</key>
			<string>التنبيهات، بندان يحتاجان انتباهك</string>
			<key>zero</key>
			<string>التنبيهات، لا شيء يحتاج انتباهك</string>
		</dict>
	</dict>
	<key>In %lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
