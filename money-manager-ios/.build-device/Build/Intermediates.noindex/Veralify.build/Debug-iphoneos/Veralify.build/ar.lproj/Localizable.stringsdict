			<key>many</key>
			<string>%lld شهرًا</string>
			<key>one</key>
			<string>شهر واحد</string>
			<key>other</key>
			<string>%lld شهر</string>
			<key>two</key>
			<string>شهران</string>
			<key>zero</key>
			<string>لا أشهر</string>
