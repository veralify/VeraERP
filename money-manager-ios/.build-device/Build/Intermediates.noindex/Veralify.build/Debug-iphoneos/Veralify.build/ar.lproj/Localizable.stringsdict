			<key>other</key>
			<string>بقي %lld شهر من خطتك</string>
			<key>two</key>
			<string>بقي شهران من خطتك</string>
			<key>zero</key>
			<string>لم يتبقَّ من خطتك شيء</string>
		</dict>
	</dict>
	<key>%lld payments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
