<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ is due in %lld days.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%1$@ مستحقة خلال %2$lld أيام.</string>
			<key>many</key>
			<string>%1$@ مستحقة خلال %2$lld يومًا.</string>
			<key>one</key>
			<string>%1$@ مستحقة خلال يوم.</string>
			<key>other</key>
			<string>%1$@ مستحقة خلال %2$lld يوم.</string>
			<key>two</key>
			<string>%1$@ مستحقة خلال يومين.</string>
			<key>zero</key>
			<string>%1$@ مستحقة اليوم.</string>
		</dict>
	</dict>
	<key>%lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld أيام</string>
			<key>many</key>
			<string>%lld يومًا</string>
			<key>one</key>
			<string>يوم واحد</string>
			<key>other</key>
			<string>%lld يوم</string>
			<key>two</key>
			<string>يومان</string>
			<key>zero</key>
			<string>لا أيام</string>
		</dict>
	</dict>
	<key>%lld days late</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>متأخر بـ %lld أيام</string>
			<key>many</key>
			<string>متأخر بـ %lld يومًا</string>
			<key>one</key>
			<string>متأخر بيوم</string>
			<key>other</key>
			<string>متأخر بـ %lld يوم</string>
			<key>two</key>
			<string>متأخر بيومين</string>
			<key>zero</key>
			<string>متأخر</string>
		</dict>
	</dict>
	<key>%lld items have no due date, so nothing can be scheduled for them.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld عناصر بلا تاريخ استحقاق، فلا يمكن جدولة شيء لها.</string>
			<key>many</key>
			<string>%lld عنصرًا بلا تاريخ استحقاق، فلا يمكن جدولة شيء لها.</string>
			<key>one</key>
			<string>عنصر واحد بلا تاريخ استحقاق، فلا يمكن جدولة شيء له.</string>
			<key>other</key>
			<string>%lld عنصر بلا تاريخ استحقاق، فلا يمكن جدولة شيء لها.</string>
			<key>two</key>
			<string>عنصران بلا تاريخ استحقاق، فلا يمكن جدولة شيء لهما.</string>
			<key>zero</key>
			<string>لا عناصر بلا تاريخ استحقاق.</string>
		</dict>
	</dict>
	<key>%lld items have no due date, so they can't be flagged.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld بنود بلا تاريخ استحقاق، لذا لا يمكن تنبيهك بشأنها.</string>
			<key>many</key>
			<string>%lld بندًا بلا تاريخ استحقاق، لذا لا يمكن تنبيهك بشأنها.</string>
			<key>one</key>
			<string>بند واحد بلا تاريخ استحقاق، لذا لا يمكن تنبيهك بشأنه.</string>
			<key>other</key>
			<string>%lld بند بلا تاريخ استحقاق، لذا لا يمكن تنبيهك بشأنها.</string>
			<key>two</key>
			<string>بندان بلا تاريخ استحقاق، لذا لا يمكن تنبيهك بشأنهما.</string>
		</dict>
	</dict>
