<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld giorno</string>
			<key>other</key>
			<string>%lld giorni</string>
		</dict>
	</dict>
	<key>%lld items have no due date, so they can't be flagged.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld voce non ha scadenza, quindi non può essere segnalata.</string>
			<key>other</key>
			<string>%lld voci non hanno scadenza, quindi non possono essere segnalate.</string>
		</dict>
	</dict>
	<key>%lld months</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld mese</string>
			<key>other</key>
			<string>%lld mesi</string>
		</dict>
	</dict>
	<key>%lld payments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld rata</string>
			<key>other</key>
			<string>%lld rate</string>
		</dict>
	</dict>
	<key>Alerts, %lld needing attention</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Avvisi, %lld richiede attenzione</string>
			<key>other</key>
			<string>Avvisi, %lld richiedono attenzione</string>
		</dict>
	</dict>
	<key>Showing %lld entries</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld voce mostrata</string>
			<key>other</key>
			<string>%lld voci mostrate</string>
		</dict>
	</dict>
	<key>Worked out over the %lld payments you have left. If your lender's letter says otherwise, use their figure.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Calcolata sulla %lld rata che ti resta. Se la lettera del tuo istituto dice altro, usa il loro importo.</string>
			<key>other</key>
			<string>Calcolata sulle %lld rate che ti restano. Se la lettera del tuo istituto dice altro, usa il loro importo.</string>
		</dict>
	</dict>
	<key>in %lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>tra %lld giorno</string>
			<key>other</key>
			<string>tra %lld giorni</string>
		</dict>
	</dict>
</dict>
</plist>
