    },
    "Add your income and expenses to see how your month breaks down.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف دخلك ومصاريفك لترى تحليلًا لتدفقك الشهري."
