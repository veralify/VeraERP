    },
    "Add debt": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة دين"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi debito"
          }
        }
      }
    },
    "Add rent, bills and any recurring monthly commitment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف الإيجار والفواتير وأي التزام شهري متكرر."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi affitto, bollette e ogni impegno mensile ricorrente."
          }
        }
      }
    },
    "Add what you actually receive each month. You can change this later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف صافي ما تستلمه شهريًا. يمكنك تعديل ذلك لاحقًا."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi quanto ricevi davvero ogni mese. Potrai modificarlo in seguito."
          }
        }
      }
    },
    "Add your debts and we'll build your payoff plan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ديونك لنحسب لك خطة السداد."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i tuoi debiti e creeremo il piano di rimborso."
          }
        }
      }
    },
    "Add your first credit or debit to start the ledger.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف أول إيداع أو سحب لتبدأ السجل."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi la prima entrata o uscita per iniziare il registro."
          }
        }
      }
    },
    "Add your income and debts whenever you're ready": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف دخلك وديونك متى شئت"
