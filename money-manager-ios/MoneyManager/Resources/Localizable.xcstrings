    "Your data is stored on this device only and is never sent to a server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بياناتك محفوظة على هذا الجهاز فقط، ولا تُرسل إلى أي خادم."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati sono salvati solo su questo dispositivo e non vengono mai inviati a un server."
          }
