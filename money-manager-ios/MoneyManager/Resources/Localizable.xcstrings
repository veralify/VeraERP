          "stringUnit": {
            "state": "translated",
            "value": "تحتاج %@ شهريًا خلال %lld شهرًا، وهو أكثر مما هو متاح."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You'd need %1$@ a month across %2$lld months, which is more than you have."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servirebbero %@ al mese per %lld mesi, più di quanto hai."
          }
        }
      }
    },
    "You're %@ short each month. Review your expenses or payments.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت بالسالب %@ شهريًا. راجع المصاريف أو الأقساط."
