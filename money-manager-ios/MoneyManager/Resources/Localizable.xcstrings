    "Your income, expenses and debts will be permanently deleted and setup will start again. This cannot be undone.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف دخلك ومصاريفك وديونك نهائيًا، وتبدأ الإعداد من جديد. لا يمكن التراجع."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrate, spese e debiti saranno eliminati definitivamente e la configurazione ripartirà. L'operazione è irreversibile."
          }
        }
      }
    },
    "Your income, expenses, debts and recorded entries will be permanently deleted and setup will start again. This cannot be undone.": {
      "localizations": {
