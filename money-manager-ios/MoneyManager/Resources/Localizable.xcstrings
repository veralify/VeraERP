    "Where your income goes": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى أين يذهب دخلك"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove vanno le tue entrate"
          }
        }
      }
    },
    "Which debts are you paying off?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الديون التي تسددها؟"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quali debiti stai rimborsando?"
          }
        }
      }
    },
    "Which one takes the most": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيها يستهلك أكبر قدر"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale pesa di più"
          }
        }
      }
    },
    "You'd need %@ a month across %lld months, which is more than you have.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج %@ شهريًا خلال %lld شهرًا، وهو أكثر مما هو متاح."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You'd need %1$@ a month across %2$lld months, which is more than you have."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servirebbero %@ al mese per %lld mesi, più di quanto hai."
          }
        }
      }
    },
    "You're %@ short each month. Review your expenses or payments.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت بالسالب %@ شهريًا. راجع المصاريف أو الأقساط."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti mancano %@ al mese. Rivedi le spese o le rate."
          }
        }
      }
    },
    "Your commitments exceed your income": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التزاماتك تتجاوز دخلك"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli impegni superano le entrate"
          }
        }
      }
    },
    "Your commitments exceed your income this month": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التزاماتك تتجاوز دخلك هذا الشهر"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo mese gli impegni superano le entrate"
          }
        }
      }
    },
    "Your data": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بياناتك"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati"
          }
        }
      }
    },
    "Your data is stored on this device only and is never sent to a server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بياناتك محفوظة على هذا الجهاز فقط، ولا تُرسل إلى أي خادم."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati sono salvati solo su questo dispositivo e non vengono mai inviati a un server."
          }
        }
      }
    },
    "Your data stays on your device": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بياناتك محفوظة على جهازك فقط"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati restano sul dispositivo"
          }
        }
      }
    },
    "Your fixed monthly commitments.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الالتزامات الشهرية الثابتة."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi impegni mensili fissi."
          }
        }
      }
    },
    "Your income, expenses and debts will be permanently deleted and setup will start again. This cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف دخلك ومصاريفك وديونك نهائيًا، وتبدأ الإعداد من جديد. لا يمكن التراجع."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrate, spese e debiti saranno eliminati definitivamente e la configurazione ripartirà. L'operazione è irreversibile."
          }
        }
      }
    },
    "Your money, with a clear plan": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أموالك، بخطة واضحة"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi soldi, con un piano chiaro"
          }
        }
      }
    },
