    "%@ goes out against %@ coming in. Until that closes, the payoff plan cannot hold.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخرج %@ مقابل %@ داخلة. وما لم تُغلق هذه الفجوة، لن تصمد خطة السداد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ goes out against %@ coming in. Until that closes, the payoff plan cannot hold."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Escono %@ a fronte di %@ che entrano. Finché quel divario non si chiude, il piano di rimborso non regge."
          }
        }
