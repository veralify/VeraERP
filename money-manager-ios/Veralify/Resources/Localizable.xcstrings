        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Paghi"
          }
        }
      }
    },
    "You'd need %@ a month across %lld months, which is more than you have.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج %@ شهريًا خلال %lld شهرًا، وهو أكثر مما هو متاح."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You'd need %1$@ a month across %2$lld months, which is more than you have."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servirebbero %@ al mese per %lld mesi, più di quanto hai."
          }
        }
      }
    },
    "You're %@ short each month. Review your expenses or payments.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت بالسالب %@ شهريًا. راجع المصاريف أو الأقساط."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti mancano %@ al mese. Rivedi le spese o le rate."
          }
        }
      }
    },
    "Your %@ (%@) expires in %lld days. Open Veralify to check the details.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتهي %@ (%@) خلال %lld يومًا. افتح Veralify لمراجعة التفاصيل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your %1$@ (%2$@) expires in %3$lld days. Open Veralify to check the details."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo %@ (%@) scade tra %lld giorni. Apri Veralify per i dettagli."
          }
        }
      }
    },
    "Your commitments exceed your income": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التزاماتك تتجاوز دخلك"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli impegni superano le entrate"
          }
        }
