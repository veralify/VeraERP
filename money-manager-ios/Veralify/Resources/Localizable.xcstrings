    "Drag the leftover circle onto a debt to pay more of it each month. Drag a debt back onto it to take the extra off again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب دائرة المتبقي فوق أي دَيْن لتدفع له أكثر كل شهر، واسحب الدَّين إليها لتسحب الزيادة مرة أخرى."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina il cerchio dell’avanzo su un debito per pagarne di più ogni mese. Trascina un debito sul cerchio per togliere di nuovo l’extra."
          }
        }
      }
    },
    "Drag the lime circle onto a debt to pay more of it each month. Drag a debt back onto it to pay less.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الدائرة الليمونية فوق أي دَيْن لتدفع له أكثر كل شهر، واسحب الدَّين إليها لتدفع أقل."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina il cerchio lime su un debito per pagarne di più ogni mese. Trascina un debito sul cerchio per pagarne di meno."
          }
        }
      }
    },
