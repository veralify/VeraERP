    "Only you can say whether you have done this, so this one is yours to tick.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت وحدك من يعرف إن كنت قد فعلت ذلك، لذا هذه المهمة تؤشّرها بنفسك."
          }
        },
