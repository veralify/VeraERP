    "XP comes from finishing the day's quests on Today. Nothing else earns it, and nothing takes it away.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي نقاط الخبرة من إنهاء مهام اليوم في تبويب «اليوم». لا شيء آخر يمنحها، ولا شيء يسلبها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "XP comes from finishing the day's quests on Today. Nothing else earns it, and nothing takes it away."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli XP arrivano dal completare le missioni del giorno nella scheda Oggi. Nient'altro li fa guadagnare e nulla li toglie."
          }
        }
      }
    },
