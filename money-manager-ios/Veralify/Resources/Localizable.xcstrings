          "stringUnit": {
            "state": "translated",
            "value": "Nessuna scadenza nei prossimi 30 giorni."
          }
        }
      }
    },
    "Nothing is left over this month, so there is nothing to move. Tap a circle to open it, or + to add one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتبقَّ شيء هذا الشهر، فلا يوجد ما يُنقل. اضغط على أي دائرة لفتحها، أو على + لإضافة واحدة."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo mese non resta nulla, quindi non c’è niente da spostare. Tocca un cerchio per aprirlo, o + per aggiungerne uno."
          }
        }
      }
    },
    "Nothing logged yet today": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُسجَّل حركات اليوم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing logged yet today"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi non hai registrato nulla"
          }
        }
      }
    },
    "Nothing needs your attention": {
      "localizations": {
