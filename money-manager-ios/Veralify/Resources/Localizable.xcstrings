        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سداد %1$@ يستغرق %2$lld شهرًا بواقع %3$@ شهريًا، وينتهي في %4$@. أما تكلفة الاقتراض نفسها فهي %5$@، أي %6$lld%% من كل ما تدفعه."
          }
