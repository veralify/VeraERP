        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف من تتقاسم معهم المال. سجّل ما يدفعه كل واحد وسيحسب التطبيق من يدين لمن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the people you split money with. Log what each of you pays and the app works out who owes whom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi le persone con cui dividi le spese. Registra quanto paga ciascuno e l'app calcola chi deve cosa a chi."
          }
        }
      }
    },
