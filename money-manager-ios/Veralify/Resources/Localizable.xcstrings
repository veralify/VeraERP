    "Tap Add — it is on every tab — type the amount, pick money in or money out, and swipe to confirm. One entry is enough to finish this.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «إضافة» — وهو موجود في كل تبويب — أدخل المبلغ، واختر وارد أو صادر، ثم اسحب للتأكيد. حركة واحدة تكفي لإتمامها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Add — it is on every tab — type the amount, pick money in or money out, and swipe to confirm. One entry is enough to finish this."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Aggiungi — c'è in ogni scheda — inserisci l'importo, scegli entrate o uscite e scorri per confermare. Basta una voce per completarla."
          }
        }
      }
    },
    "Target period": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدة المستهدفة"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Periodo obiettivo"
          }
        }
      }
    },
    "That's %@ each — %lld of us round up to %@ so it comes out exact.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي %@ لكل شخص — %lld منّا يدفعون %@ ليخرج المجموع مضبوطًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "That's %1$@ each — %2$lld of us round up to %3$@ so it comes out exact."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanno %@ a testa: %lld di noi arrotondano a %@ così torna esatto."
          }
        }
      }
    },
    "That's %@ each, %lld ways.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي %@ لكل شخص، مقسومة على %lld."
