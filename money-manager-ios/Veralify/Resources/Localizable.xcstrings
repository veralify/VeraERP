    "%lld items have no due date, so they can't be flagged.": {
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld بنود بلا تاريخ استحقاق، لذا لا يمكن تنبيهك بشأنها."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld بندًا بلا تاريخ استحقاق، لذا لا يمكن تنبيهك بشأنها."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "بند واحد بلا تاريخ استحقاق، لذا لا يمكن تنبيهك بشأنه."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld بند بلا تاريخ استحقاق، لذا لا يمكن تنبيهك بشأنها."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "بندان بلا تاريخ استحقاق، لذا لا يمكن تنبيهك بشأنهما."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld item has no due date, so it can't be flagged."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld items have no due date, so they can't be flagged."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld voce non ha scadenza, quindi non può essere segnalata."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld voci non hanno scadenza, quindi non possono essere segnalate."
                }
              }
            }
          }
        }
      }
    },
