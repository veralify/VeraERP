    },
    "Nothing shared yet. Add an expense and it splits between whoever you pick.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد شيء مشترك بعد. أضف مصروفًا وسيُقسَّم على من تختارهم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing shared yet. Add an expense and it splits between whoever you pick."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente di condiviso. Aggiungi una spesa e verrà divisa tra chi scegli."
