          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cifre di controllo del documento confermano la lettura. Vale comunque un'occhiata."
          }
        }
      }
    },
    "There isn't enough information to work out a new monthly payment — the debt needs an interest rate and a monthly payment that covers it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد معلومات كافية لحساب قسط شهري جديد — يحتاج الدين إلى نسبة فائدة وقسط شهري يغطيها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There isn't enough information to work out a new monthly payment — the debt needs an interest rate and a monthly payment that covers it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono dati sufficienti per calcolare una nuova rata: il debito richiede un tasso di interesse e una rata che lo copra."
          }
        }
      }
    },
    "This cannot be undone.": {
