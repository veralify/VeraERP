    "Reminders come from this phone's own clock. Nothing is sent to a server, so no amount or due date ever leaves the device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي التذكيرات من ساعة هذا الهاتف نفسه. لا يُرسل شيء إلى أي خادم، فلا يغادر الجهاز أي مبلغ أو تاريخ استحقاق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders come from this phone's own clock. Nothing is sent to a server, so no amount or due date ever leaves the device."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria arrivano dall'orologio di questo telefono. Non viene inviato nulla a un server, quindi nessun importo o scadenza lascia il dispositivo."
          }
        }
      }
    },
