                "stringUnit": {
                  "state": "translated",
                  "value": "Calcolata sulla %lld rata che ti resta. Se la lettera del tuo istituto dice altro, usa il loro importo."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Calcolata sulle %lld rate che ti restano. Se la lettera del tuo istituto dice altro, usa il loro importo."
                }
              }
            }
          }
        }
      }
    },
    "You'd need %@ a month across %lld months, which is more than you have.": {
      "localizations": {
