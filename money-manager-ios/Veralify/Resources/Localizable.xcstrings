    "Your data": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بياناتك"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati"
          }
        }
      }
    },
    "Your data is stored on this device only and is never sent to a server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بياناتك محفوظة على هذا الجهاز فقط، ولا تُرسل إلى أي خادم."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati sono salvati solo su questo dispositivo e non vengono mai inviati a un server."
          }
        }
      }
    },
    "Your data stays on your device": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بياناتك محفوظة على جهازك فقط"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati restano sul dispositivo"
          }
        }
      }
    },
    "Your income, expenses, debts and recorded entries will be permanently deleted and setup will start again. This cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف دخلك ومصاريفك وديونك وحركاتك المسجلة نهائيًا، وتبدأ الإعداد من جديد. لا يمكن التراجع."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrate, spese, debiti e movimenti registrati saranno eliminati definitivamente e la configurazione ripartirà. L'operazione è irreversibile."
          }
        }
      }
    },
