    "Worked out over the %lld payments you have left. If your lender's letter says otherwise, use their figure.": {
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "محسوب على الدفعات الـ%lld المتبقية. إذا ذكر خطاب المُقرض غير ذلك، فاعتمد رقمه."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "محسوب على الـ%lld دفعة المتبقية. إذا ذكر خطاب المُقرض غير ذلك، فاعتمد رقمه."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "محسوب على الدفعة الواحدة المتبقية. إذا ذكر خطاب المُقرض غير ذلك، فاعتمد رقمه."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "محسوب على الـ%lld دفعة المتبقية. إذا ذكر خطاب المُقرض غير ذلك، فاعتمد رقمه."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "محسوب على الدفعتين المتبقيتين. إذا ذكر خطاب المُقرض غير ذلك، فاعتمد رقمه."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "محسوب على الدفعات المتبقية. إذا ذكر خطاب المُقرض غير ذلك، فاعتمد رقمه."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Worked out over the %lld payment you have left. If your lender's letter says otherwise, use their figure."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Worked out over the %lld payments you have left. If your lender's letter says otherwise, use their figure."
