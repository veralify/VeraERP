    "%lld of %lld pay %@, the rest pay %@. That way it adds up to the bill exactly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld من %lld يدفعون %@، والباقي يدفعون %@. بهذه الطريقة يتطابق المجموع مع الفاتورة تمامًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld pay %3$@, the rest pay %4$@. That way it adds up to the bill exactly."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld su %lld pagano %@, gli altri %@. Così il totale corrisponde esattamente al conto."
          }
        }
      }
    },
