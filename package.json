    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^15.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^6.17.2",
    "stripe": "^22.5.0",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
