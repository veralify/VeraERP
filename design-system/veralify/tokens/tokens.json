  "typography": {
    "fontFamily": {
      "sans": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Segoe UI', sans-serif",
      "mono": "'SF Mono', ui-monospace, Menlo, Monaco, Consolas, monospace"
    },
    "scale": {
      "display": { "size": 56, "lineHeight": 60, "weight": 800, "tracking": -1.7 },
      "h1": { "size": 40, "lineHeight": 46, "weight": 750, "tracking": -1.1 },
      "h2": { "size": 32, "lineHeight": 38, "weight": 700, "tracking": -0.8 },
      "h3": { "size": 24, "lineHeight": 30, "weight": 700, "tracking": -0.4 },
      "body": { "size": 16, "lineHeight": 24, "weight": 450, "tracking": 0 },
      "body-strong": { "size": 16, "lineHeight": 24, "weight": 650, "tracking": 0 },
      "caption": { "size": 13, "lineHeight": 18, "weight": 500, "tracking": 0.1 },
      "mono-numeric": { "size": 22, "lineHeight": 28, "weight": 700, "tracking": -0.3 }
    }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96
  },
  "radii": { "xs": 6, "sm": 10, "md": 14, "lg": 20, "xl": 28, "2xl": 36, "pill": 999 },
  "borders": { "hairline": 0.5, "default": 1, "strong": 2, "focus": 3 },
  "elevation": {
    "shadow": {
      "sm": "0 1px 2px rgb(0 0 0 / 0.28)",
      "md": "0 10px 28px rgb(0 0 0 / 0.32)",
      "lg": "0 24px 70px rgb(0 0 0 / 0.42)",
      "glow-primary": "0 0 36px rgb(77 149 247 / 0.36)",
      "glow-live": "0 0 32px rgb(248 76 95 / 0.40)"
    },
    "blur": { "glass": 20, "background-glow": 96 }
  },
  "motion": {
    "duration": { "instant": 80, "fast": 150, "base": 220, "slow": 360, "hero": 520 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "entrance": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.7, 0, 0.84, 0)"
    }
  },
  "zIndex": {
    "base": 0,
    "raised": 10,
    "sticky": 100,
    "nav": 200,
    "overlay": 400,
    "modal": 500,
    "toast": 600,
    "coachmark": 700
  },
  "breakpoints": { "xs": 375, "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1536 },
  "safeArea": {
    "ios": {
      "minimumHitTarget": 44,
      "bottomNavClearance": 96,
      "sheetGrabberWidth": 36,
      "edgePadding": 16,
      "respectInsets": ["top", "bottom", "leading", "trailing"],
      "keyboardAvoidance": "interactive"
    }
  }
}
